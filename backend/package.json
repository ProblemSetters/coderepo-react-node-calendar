{
    "name": "calendar-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Calendar workspace API",
    "main": "src/index.js",
    "scripts": {
        "start": "bun src/index.js",
        "dev": "bun --watch src/index.js",
        "seed": "bun src/scripts/seed.js",
        "colors:migrate": "node src/scripts/update-demo-colors.js",
        "test": "cross-env NODE_ENV=test CALENDAR_TEST_AUTH_BYPASS=true NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
        "test:coverage": "cross-env NODE_ENV=test CALENDAR_TEST_AUTH_BYPASS=true NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand"
    },
    "dependencies": {
        "bcryptjs": "3.0.2",
        "cors": "2.8.6",
        "dotenv": "17.3.1",
        "express": "5.2.1",
        "jsonwebtoken": "9.0.2",
        "mongoose": "8.24.1",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "cross-env": "7.0.3",
        "jest": "30.3.0",
        "jest-junit": "17.0.0",
        "mongodb-memory-server": "10.1.4",
        "supertest": "7.2.2"
    }
}
