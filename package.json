{
	"name": "calendar",
	"version": "1.0.0",
	"private": true,
	"description": "Calendar Scheduling App - MERN Stack Monorepo",
	"workspaces": [
		"frontend",
		"backend"
	],
	"scripts": {
		"prestart": "bash setup.sh --start",
		"start": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:frontend": "cd frontend && bun run dev",
		"dev:backend": "cd backend && bun run dev",
		"seed": "cd backend && bun run seed",
		"test": "node scripts/run-tests.cjs",
		"test:backend": "cd backend && bun run test",
		"test:frontend": "cd frontend && bun run test"
	},
	"devDependencies": {
		"concurrently": "9.2.1"
	}
}
